# ============================================================================
# DataForge 造数工厂 — 环境变量模板（本地 / 服务器共用）
# 用法：cp .env.example .env 并填写实际值
# 注意：.env 禁止提交到 Git（已在 .gitignore 中忽略）
# ============================================================================

# ── 系统库 MySQL（公司外部实例）────────────────────────────────────────────
# 完整连接串（密码含特殊字符需 URL 编码，如 % -> %25、! -> %21）
DATABASE_URL=mysql+aiomysql://popsicle:QY20Lsf%25%21PLfM25Ts%21@172.28.30.59:3306/data_factory

# ── Redis（公司外部实例）───────────────────────────────────────────────────
# 格式：redis://[:密码]@host:port/db
REDIS_URL=redis://:baiwang@172.28.31.239:6379/3

# ── 应用密钥（生产环境必须修改）─────────────────────────────────────────────
# JWT 签名密钥（32 字节随机 hex）
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dataforge-dev-secret-key-change-me-in-production

# 数据源密码 AES-256 加密密钥（32 字节，Base64 编码）
# 生成：python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
AES_KEY=your_aes_key_32bytes_base64encoded

# ── Nacos 配置中心 ─────────────────────────────────────────────────────────
# Nacos 地址（本地调试用 localhost:8848；线上改为实际地址）
NACOS_SERVER=localhost:8848
# 命名空间 ID（留空 = public）
NACOS_NAMESPACE=
# 配置分组（与控制台创建的 Group 一致）
NACOS_GROUP=datafactory_group
# 统一业务配置 Data ID
NACOS_DATA_ID=popsicle_datafactory_config
# Nacos 客户端认证（默认账号 nacos/nacos，生产建议修改）
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# ── 日志级别（DEBUG/INFO/WARNING/ERROR）────────────────────────────────────
LOG_LEVEL=INFO
